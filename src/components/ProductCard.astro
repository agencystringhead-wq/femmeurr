---
import type { Product } from '../lib/products';
import { SITE_URL, formatINR, whatsappLink } from '../config';

interface Props {
  product: Product;
  whatsappNumber: string;
  phoneNumber: string;
  hidden?: boolean; // set by the server when a ?c= filter excludes this card
}

const { product, whatsappNumber, phoneNumber, hidden = false } = Astro.props;
const price = formatINR(product.price_inr);
const priceSize = price.length >= 10 ? 'xlong' : price.length >= 9 ? 'long' : ''; // long prices (lakhs) shrink so the row never wraps
// Full image URL on its own line so the owner sees exactly which piece in the chat.
const imageLink = product.image_url ? new URL(product.image_url, SITE_URL).href : '';
const message = `Hi Femmeurr, I'd like to order ${product.code} - ${price}${imageLink ? `\n${imageLink}` : ''}`;
const waHref = whatsappLink(whatsappNumber, message);
---

<article class="card" data-cat={product.category_slug} hidden={hidden}>
  <div class="media" data-full={product.image_url ?? undefined} data-code={product.code}>
    {product.image_url && (
      <img
        src={product.image_url}
        alt={`Femmeurr jewellery ${product.code}`}
        width="600"
        height="600"
        loading="lazy"
        decoding="async"
      />
    )}
  </div>
  <div class="body">
    <div class="info">
      <p class:list={['price', priceSize]}>{price}</p>
      <p class="code">{product.code}</p>
    </div>
    <div class="actions">
      <a class="btn btn-wa" href={waHref} target="_blank" rel="noopener" aria-label={`Order ${product.code} on WhatsApp`}>
        Order
      </a>
      <a class="btn btn-call" href={`tel:+${phoneNumber}`} aria-label={`Call to ask about ${product.code}`}>Call</a>
    </div>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; }
  .card[hidden] { display: none; }
  .media { aspect-ratio: 1 / 1; border-radius: 14px; overflow: hidden; background: #f2f2f2; }
  .media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .body { padding: 1rem 0.1rem 0; display: flex; flex-direction: column; flex: 1; }
  .info { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; }
  .price { margin: 0; font-family: 'Lato', var(--font-body); font-weight: 400; font-size: clamp(1rem, calc(13.4vw - 27px), 1.75rem); /* sized from the free space in a 2-column card */ line-height: 1; letter-spacing: 0; white-space: nowrap; }
  .price.long { font-size: clamp(0.9rem, calc(10.8vw - 22px), 1.5rem); }
  .price.xlong { font-size: clamp(0.85rem, calc(9.5vw - 19.5px), 1.3rem); }
  .code { margin: 0; font-size: 0.75rem; line-height: 1.3; letter-spacing: 0.1em; color: var(--muted); white-space: nowrap; text-align: right; }
  .actions { display: flex; gap: 0.45rem; margin-top: auto; padding-top: 0.875rem; }
  .btn {
    flex: 1; text-align: center; text-decoration: none; font-size: 0.8rem; letter-spacing: 0.06em;
    padding: 0.55rem 0.4rem; border-radius: 999px; border: 1px solid var(--gold-text); min-height: 38px;
    display: inline-flex; align-items: center; justify-content: center;
  }
  @media (max-width: 340px) {
    .code { font-size: 0.7rem; letter-spacing: 0.06em; }
  }
  .btn-wa { background: var(--gold-text); color: #fff; }
  .btn-call { color: var(--gold-text); background: transparent; }
  .btn:hover, .btn:focus-visible { background: var(--charcoal); border-color: var(--charcoal); color: #fff; }
</style>
