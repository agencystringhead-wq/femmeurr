---
import type { Product } from '../data/sample-products';
import { formatINR, whatsappLink } from '../config';

interface Props {
  product: Product;
  whatsappNumber: string;
  phoneNumber: string;
}

const { product, whatsappNumber, phoneNumber } = Astro.props;
const soldOut = product.quantity <= 0;
const low = !soldOut && product.quantity <= 2;
const stockLabel = soldOut ? 'Sold out' : low ? `Only ${product.quantity} left` : 'In stock';
const price = formatINR(product.price_inr);
const message = `Hi Femmeurr, I'd like to order ${product.name} (Code ${product.code}) - ${price}`;
const waHref = whatsappLink(whatsappNumber, message);
---

<article class:list={['card', { 'is-sold-out': soldOut }]}>
  <div class="media">
    <img
      src={product.image_url}
      alt={`${product.name}, Femmeurr jewellery`}
      width="600"
      height="600"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="body">
    <h3 class="name">{product.name}</h3>
    <p class="price">{price}</p>
    <p class:list={['badge', { low, out: soldOut }]}>{stockLabel}</p>
    <div class="actions">
      <a class="btn btn-wa" href={waHref} target="_blank" rel="noopener" aria-label={`${soldOut ? 'Enquire about' : 'Order'} ${product.name} on WhatsApp`}>
        {soldOut ? 'Enquire' : 'Order'}
      </a>
      <a class="btn btn-call" href={`tel:+${phoneNumber}`} aria-label={`Call to ask about ${product.name}`}>Call</a>
    </div>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; }
  .media { aspect-ratio: 1 / 1; border-radius: 14px; overflow: hidden; background: #efe8dc; }
  .media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .body { padding: 0.7rem 0.1rem 0; display: flex; flex-direction: column; gap: 0.2rem; flex: 1; }
  .name { font-family: var(--font-display); font-weight: 500; font-size: 1.15rem; line-height: 1.2; margin: 0; }
  .price { margin: 0; font-size: 0.95rem; letter-spacing: 0.02em; }
  .badge { margin: 0; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .badge.low { color: var(--gold-text); }
  .actions { display: flex; gap: 0.45rem; margin-top: auto; padding-top: 0.6rem; }
  .btn {
    flex: 1; text-align: center; text-decoration: none; font-size: 0.8rem; letter-spacing: 0.06em;
    padding: 0.55rem 0.4rem; border-radius: 999px; border: 1px solid var(--gold-text); min-height: 38px;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .btn-wa { background: var(--gold-text); color: #fff; }
  .btn-call { color: var(--gold-text); background: transparent; }
  .btn:hover, .btn:focus-visible { background: var(--charcoal); border-color: var(--charcoal); color: #fff; }
  .is-sold-out .media, .is-sold-out .name, .is-sold-out .price { opacity: 0.55; }
  .is-sold-out .btn-wa { background: transparent; color: var(--gold-text); }
  .is-sold-out .btn-wa:hover, .is-sold-out .btn-wa:focus-visible { background: var(--charcoal); color: #fff; }
</style>
