---
import Storeroom from '../../layouts/Storeroom.astro';
import { formatINR } from '../../config';
import { CATEGORIES, categoryByKey } from '../../categories';
import { imageUrl } from '../../lib/products';
import { listAllProducts, type StoreroomProduct } from '../../lib/storeroom';

export const prerender = false;

const authed = Astro.locals.isAuthed;
const q = Astro.url.searchParams;

const loginErrors: Record<string, string> = {
  wrong: 'That password is not right. Please try again.',
  blocked: 'Too many wrong tries. Please wait 15 minutes and try again.',
  error: 'Something went wrong. Please try again in a moment.',
};
const loginError = loginErrors[q.get('e') ?? ''];

let products: StoreroomProduct[] = [];
let loadFailed = false;
if (authed) {
  try {
    products = await listAllProducts();
  } catch (error) {
    console.error('Storeroom list failed', error);
    loadFailed = true;
  }
}
const inStock = products.filter((p) => p.quantity > 0).length;
const soldOut = products.length - inStock;
const catSlug = (key: string | null) => categoryByKey(key)?.slug ?? 'none';
const countFor = (slug: string) => products.filter((p) => catSlug(p.category) === slug).length;
---

<Storeroom title={authed ? 'Products' : 'Login'} showLogout={authed}>
  {!authed ? (
    <main class="login">
      <img src="/logo-400.png" alt="Femmeurr" width="400" height="282" />
      <form method="post" action="/api/storeroom/login">
        <label class="field">
          <span>Password</span>
          <input type="password" name="password" autocomplete="current-password" required autofocus />
        </label>
        {loginError && <p class="notice bad" role="alert">{loginError}</p>}
        <button class="big-btn" type="submit">Enter</button>
      </form>
    </main>
  ) : (
    <main class="sr-wrap">
      {q.get('saved') && <p class="notice ok" role="status">Saved.</p>}
      {q.get('added') && <p class="notice ok" role="status">Added. Its code is <b>{q.get('added')}</b>.</p>}
      {q.get('deleted') && <p class="notice ok" role="status">Item deleted.</p>}
      {loadFailed && <p class="notice bad" role="alert">Could not load the items. Please refresh the page.</p>}

      <div class="top-actions">
        <a class="big-btn add-btn" href="/storeroom/new">+ Add product</a>
        <a class="big-btn outline reorder-btn" href="/storeroom/reorder">Reorder</a>
      </div>

      <div class="counts" aria-label="Summary">
        <div><b id="count-total">{products.length}</b><span>Items</span></div>
        <div><b id="count-in">{inStock}</b><span>In stock</span></div>
        <div><b id="count-out">{soldOut}</b><span>Sold out</span></div>
      </div>

      <div class="chips" role="group" aria-label="Filter by category">
        <button type="button" class="chip is-active" data-chip="all" aria-pressed="true">All <b>{products.length}</b></button>
        {CATEGORIES.map((c) => (
          <button type="button" class="chip" data-chip={c.slug} aria-pressed="false">{c.plural} <b>{countFor(c.slug)}</b></button>
        ))}
        <button type="button" class="chip" data-chip="none" aria-pressed="false">Uncategorised <b>{countFor('none')}</b></button>
      </div>

      <div class="search">
        <input type="search" id="search" placeholder="Search by code, like FM-012" aria-label="Search by code" autocomplete="off" />
      </div>

      <div class="list" id="list">
        {products.map((p) => (
          <article class:list={['row', { 'is-hidden': !p.visible, 'is-sold': p.quantity <= 0 }]} data-search={`${p.code} ${p.display_code}`.toLowerCase()} data-cat={catSlug(p.category)} data-qty={p.quantity}>
            <a class="info" href={`/storeroom/${p.id}`} aria-label={`Edit ${p.display_code}`}>
              {imageUrl(p.image_key) ? (
                <img class="thumb" src={imageUrl(p.image_key)} alt="" width="76" height="76" loading="lazy" />
              ) : (
                <div class="thumb"></div>
              )}
              <div>
                <h2 class="name">{p.display_code}</h2>
                <p class="meta">{formatINR(p.price_inr)}</p>
                <span class="tag sold" hidden={p.quantity > 0}>Sold out - hidden from site</span>
                {!p.category && <span class="tag setcat">Set category</span>}
                {!p.visible && <span class="tag">Hidden from website</span>}
              </div>
            </a>
            <form class="qty" method="post" action={`/api/storeroom/products/${p.id}/quantity`}>
              <button type="submit" name="delta" value="-1" aria-label={`One less ${p.display_code}`}>−</button>
              <output class="q" aria-live="polite"><span class="n">{p.quantity}</span><small>in stock</small></output>
              <button type="submit" name="delta" value="1" aria-label={`One more ${p.display_code}`}>+</button>
              <span class="saved" role="status"></span>
            </form>
          </article>
        ))}
      </div>
      <p class="empty-note" id="no-match" hidden>Nothing matches.</p>
    </main>
  )}
</Storeroom>

<script>
  // Optional enhancement: +/- save without reloading, live search and counts. Everything also works without JS.
  const list = document.getElementById('list');
  if (list) {
    const rows = [...list.querySelectorAll<HTMLElement>('.row')];

    const syncSold = (row: HTMLElement) => {
      const out = Number(row.dataset.qty) <= 0;
      row.classList.toggle('is-sold', out);
      row.querySelector<HTMLElement>('.tag.sold')!.hidden = !out;
    };

    const updateCounts = () => {
      const inStock = rows.filter((r) => Number(r.dataset.qty) > 0).length;
      document.getElementById('count-in')!.textContent = String(inStock);
      document.getElementById('count-out')!.textContent = String(rows.length - inStock);
    };

    list.querySelectorAll<HTMLFormElement>('form.qty').forEach((form) => {
      const row = form.closest<HTMLElement>('.row')!;
      const n = form.querySelector('.n')!;
      const saved = form.querySelector<HTMLElement>('.saved')!;
      let timer: number | undefined;
      const flash = (text: string, isError = false) => {
        saved.textContent = text;
        saved.classList.toggle('err', isError);
        clearTimeout(timer);
        timer = window.setTimeout(() => (saved.textContent = ''), 2000);
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const delta = Number((event.submitter as HTMLButtonElement | null)?.value);
        const before = Number(row.dataset.qty);
        const optimistic = Math.max(0, before + delta);
        row.dataset.qty = String(optimistic);
        n.textContent = String(optimistic);
        syncSold(row);
        updateCounts();
        try {
          const res = await fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ delta }),
          });
          if (res.status === 401) {
            location.href = '/storeroom';
            return;
          }
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);
          row.dataset.qty = String(data.quantity);
          n.textContent = String(data.quantity);
          syncSold(row);
          updateCounts();
          flash('Saved');
        } catch {
          row.dataset.qty = String(before);
          n.textContent = String(before);
          syncSold(row);
          updateCounts();
          flash('Not saved. Try again.', true);
        }
      });
    });

    // Search (by code, with or without the category letter) and the category chips work together.
    const search = document.getElementById('search') as HTMLInputElement;
    const noMatch = document.getElementById('no-match')!;
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
    let chip = 'all';

    const applyFilters = () => {
      const term = search.value.trim().toLowerCase();
      let shown = 0;
      rows.forEach((r) => {
        const chipOk = chip === 'all' || r.dataset.cat === chip;
        const termOk = !term || (r.dataset.search ?? '').includes(term);
        r.hidden = !(chipOk && termOk);
        if (!r.hidden) shown++;
      });
      noMatch.hidden = shown > 0;
    };

    search.addEventListener('input', applyFilters);
    chips.forEach((btn) =>
      btn.addEventListener('click', () => {
        chip = btn.dataset.chip ?? 'all';
        chips.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', String(on));
        });
        applyFilters();
      }),
    );
  }
</script>
