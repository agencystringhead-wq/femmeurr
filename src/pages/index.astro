---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Lightbox from '../components/Lightbox.astro';
import { CATEGORIES, categoryBySlug } from '../categories';
import { getConfig, whatsappLink } from '../config';
import { getVisibleProducts, type Product } from '../lib/products';

const cfg = getConfig();
let products: Product[] = [];
try {
  products = await getVisibleProducts();
} catch (error) {
  console.error('Failed to load products', error);
}
// ?c=earrings (also accepts the stored key). Anything else means All.
const active = categoryBySlug(Astro.url.searchParams.get('c'))?.slug ?? '';
const visibleCount = products.filter((p) => !active || p.category_slug === active).length;
const generalWa = whatsappLink(cfg.whatsappNumber, "Hi Femmeurr, I'd like to know more about your jewellery.");
const year = new Date().getFullYear();
---

<Base
  title="Femmeurr | Shine in your own way"
  description="Necklaces | Earrings | Bracelets | Top Quality Anti-Tarnish Jewellery"
>
  <main>
    <section class="hero">
      <picture>
        <source
          type="image/webp"
          srcset="/logo-400.webp 400w, /logo-800.webp 800w"
          sizes="(min-width: 1024px) 280px, 200px"
        />
        <img
          class="logo"
          src="/logo-800.png"
          srcset="/logo-400.png 400w, /logo-800.png 800w"
          sizes="(min-width: 1024px) 280px, 200px"
          alt="Femmeurr: Shine in your own way"
          width="800"
          height="564"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <nav class="categories" aria-label="Filter by category">
        <a href="/" data-cat="" class:list={[{ active: !active }]} aria-current={!active ? 'true' : undefined}>All</a>
        {CATEGORIES.map((cat) => (
          <>
            <span class="sep" aria-hidden="true">|</span>
            <a href={`/?c=${cat.slug}`} data-cat={cat.slug} class:list={[{ active: active === cat.slug }]} aria-current={active === cat.slug ? 'true' : undefined}>{cat.plural}</a>
          </>
        ))}
      </nav>
      <h1>Top Quality <span class="nowrap">Anti-Tarnish</span> Jewellery</h1>
    </section>

    <section class="collection" aria-labelledby="collection-title">
      <h2 id="collection-title" class="sr-only">The collection</h2>
      {products.length > 0 ? (
        <p class="empty" id="cat-empty" hidden={visibleCount > 0}>New pieces coming soon</p>
        <div class="grid" id="grid" hidden={visibleCount === 0}>
          {products.map((product) => (
            <ProductCard
              product={product}
              whatsappNumber={cfg.whatsappNumber}
              phoneNumber={cfg.phoneNumber}
              hidden={!!active && product.category_slug !== active}
            />
          ))}
        </div>
      ) : (
        <p class="empty">New collection arriving soon</p>
      )}
    </section>
  </main>

  <Lightbox />

  <footer class="site-footer">
    <nav aria-label="Contact">
      <a href={generalWa} target="_blank" rel="noopener">WhatsApp</a>
      <a href={`tel:+${cfg.phoneNumber}`}>{cfg.phoneDisplay}</a>
      <a href={cfg.instagramUrl} target="_blank" rel="noopener">Instagram</a>
    </nav>
    <p>© {year} Femmeurr</p>
  </footer>

  <a class="float-wa" href={generalWa} target="_blank" rel="noopener" aria-label="Chat with Femmeurr on WhatsApp">
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.8 14.2c-.2.7-1.4 1.3-1.9 1.3-.5.1-1.1.1-1.8-.1a14 14 0 0 1-5.4-3.3c-1.5-1.5-2.4-3-2.7-3.6-.3-.6-.4-1.4.1-2l.7-.8c.2-.2.4-.2.6-.2l.5 1.2c.1.2 0 .4-.1.6l-.4.5c-.1.2-.1.3 0 .5.4.8 1.7 2.4 3.6 3 .3.1.5.1.7-.1l.6-.7c.2-.2.4-.2.6-.1l1.7.8c.2.1.3.2.3.4 0 .2 0 .6-.1 1.3Z"/></svg>
  </a>
</Base>

<style>
  .hero { text-align: center; padding: 2.75rem 1.25rem 0; max-width: 640px; margin: 0 auto; }
  .logo { width: 200px; height: auto; margin: 0 auto 1.75rem; display: block; }
  .categories {
    margin: 0; display: flex; justify-content: center; align-items: center; white-space: nowrap;
    font-size: clamp(0.62rem, 2.9vw, 0.8rem); font-weight: 400; text-transform: uppercase; letter-spacing: 0.22em;
    color: var(--gold-text);
  }
  .hero h1 {
    margin: 0.875rem 0 1.5rem; font-family: var(--font-display); font-weight: 500; color: var(--charcoal);
    font-size: 1.45rem; line-height: 1.2; letter-spacing: 0.005em; text-wrap: balance;
  }
  .hero h1 .nowrap { white-space: nowrap; }
  .categories a { color: inherit; text-decoration: none; padding: 0.65rem 0; margin: -0.65rem 0; } /* bigger tap area, same look */
  .categories a:hover { color: var(--charcoal); }
  .categories a:focus-visible { outline: 2px solid var(--gold-text); outline-offset: 2px; border-radius: 2px; }
  .categories a.active { color: var(--charcoal); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.5em; }
  .grid[hidden], .empty[hidden] { display: none; }
  @media (max-width: 340px) { .categories { letter-spacing: 0.17em; } .categories .sep { margin: 0 0.7em 0 0.5em; } }
  .categories .sep { color: var(--gold); opacity: 0.55; margin: 0 0.9em 0 0.68em; letter-spacing: 0; font-weight: 300; }
  .collection { max-width: 1180px; margin: 0 auto; padding: 0 1rem 4rem; }
  .empty { text-align: center; color: var(--muted); font-family: var(--font-display); font-size: 1.5rem; padding: 2rem 0 3rem; margin: 0; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 0.9rem; }
  .site-footer { border-top: 1px solid var(--line); text-align: center; padding: 2rem 1rem 5.5rem; font-size: 0.9rem; }
  .site-footer nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.6rem; margin-bottom: 1rem; }
  .site-footer a { color: var(--gold-text); text-decoration: none; padding: 0.4rem 0; letter-spacing: 0.04em; }
  .site-footer a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .site-footer p { margin: 0; color: var(--muted); font-size: 0.8rem; }
  .float-wa {
    position: fixed; right: 1rem; bottom: 1rem; width: 52px; height: 52px; border-radius: 50%;
    background: var(--gold-text); color: #fff; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 6px 18px rgba(43, 42, 40, 0.25); z-index: 20;
  }
  .float-wa:hover, .float-wa:focus-visible { background: var(--charcoal); }
  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.25rem 1.25rem; }
    .float-wa { display: none; }
    .site-footer { padding-bottom: 2.5rem; }
    .hero h1 { font-size: 1.875rem; margin-bottom: 2.25rem; }
  }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2.5rem 1.5rem; }
    .hero { padding-top: 4.5rem; }
    .hero h1 { font-size: 2rem; }
    .logo { width: 280px; margin-bottom: 2.25rem; }
  }
</style>

<script>
  // Instant filtering without a reload. The server already renders the right view for ?c= links,
  // so this only makes switching quick and keeps the address bar shareable.
  const nav = document.querySelector<HTMLElement>('.categories');
  const grid = document.getElementById('grid');
  const empty = document.getElementById('cat-empty');

  if (nav && grid && empty) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
    const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
    const slugs = new Set(links.map((a) => a.dataset.cat).filter(Boolean));

    const fromUrl = () => {
      const v = (new URLSearchParams(location.search).get('c') ?? '').trim().toLowerCase();
      return slugs.has(v) ? v : '';
    };

    const apply = (slug: string) => {
      let shown = 0;
      cards.forEach((card) => {
        const show = !slug || card.dataset.cat === slug;
        card.hidden = !show;
        if (show) shown++;
      });
      grid.hidden = shown === 0;
      empty.hidden = shown > 0;
      links.forEach((a) => {
        const on = (a.dataset.cat ?? '') === slug;
        a.classList.toggle('active', on);
        if (on) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    };

    links.forEach((a) =>
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return; // let "open in new tab" work
        e.preventDefault();
        const slug = a.dataset.cat ?? '';
        if (slug === fromUrl()) return;
        history.pushState({ c: slug }, '', slug ? `/?c=${slug}` : '/');
        apply(slug);
      }),
    );
    window.addEventListener('popstate', () => apply(fromUrl()));
    apply(fromUrl());
  }
</script>
